# Session Security (CRITICAL for Production)
# Generate a secure random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use the default value in production!
SESSION_SECRET=your-secure-session-secret-change-in-production

# CSRF Protection (Optional - auto-generated if not set)
# Generate a secure random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CSRF_SECRET=your-secure-csrf-secret-here

# Allowed Origins for CSRF Protection (Production Only)
# Comma-separated list of trusted origins for your application
# Replit automatically sets REPLIT_DOMAINS when deployed
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Admin Credentials
# Set these in production (Railway, etc.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecureP@ssw0rd123

# Database Connection
# Automatically provided by Railway when you add PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/database

# Testing Mode (Local Development Only)
# SECURITY WARNING: Only use this for local testing with simple passwords
# NEVER enable this in production!
# Uncomment the line below to allow any password (including "admin", "123", etc.)
# DISABLE_PASSWORD_VALIDATION=true

# Node Environment
# Automatically set by deployment platforms
# NODE_ENV=production

# ============================================================================
# GigHalal Social Authentication
# ============================================================================

# Facebook Login (Meta OAuth)
# 1. Create app at https://developers.facebook.com/apps/
# 2. Add "Facebook Login" product
# 3. Set Valid OAuth Redirect URI to: https://yourdomain.com/api/gig/auth/facebook/callback
# 4. Required permissions: public_profile, email
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret

# Apple Sign In
# 1. Register Services ID at https://developer.apple.com/account/resources/identifiers/
# 2. Configure Sign In with Apple capability
# 3. Create a private key for Sign In with Apple
# APPLE_CLIENT_ID=com.yourcompany.gighala.signin
# APPLE_TEAM_ID=your-apple-team-id
# APPLE_KEY_ID=your-apple-key-id
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# WhatsApp Business API (for OTP)
# Uses Meta's Cloud API (same Developer account as Facebook)
# 1. Set up WhatsApp Business account at https://business.facebook.com/
# 2. Create a message template named "gig_halal_otp" in Malay (ms)
# WHATSAPP_API_KEY=your-whatsapp-cloud-api-token
# WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# Frontend URL (required for OAuth redirect URIs)
# FRONTEND_URL=https://gighala.calmic.com.my

# AI Services for Hansard Analysis
# The app uses a multi-provider fallback chain — if one provider fails,
# it automatically tries the next. Configure as many as possible for reliability.
# At least ONE is required.

# Google Gemini API (FREE! 1500 req/day, 1M context window)
# Sign up at https://ai.google.dev/ — very generous free tier
# Supports multiple keys for rotation (comma-separated)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API (FREE credits on signup!)
# Sign up at https://openrouter.ai/ for $1-5 free credits
# Access to many models: DeepSeek, Qwen, Llama, Gemini, etc.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# DeepSeek API (DeepSeek-V3.2, 128K context window)
# Sign up at https://platform.deepseek.com/ — low cost, initial free credits
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Groq API (FREE and very fast! Uses Llama 3.3 70B)
# Sign up at https://console.groq.com/ — generous free tier
GROQ_API_KEY=your-groq-api-key-here

# Cerebras API (FREE! Ultra-fast inference, Llama 3.3 70B)
# Sign up at https://cloud.cerebras.ai/ — free tier available
CEREBRAS_API_KEY=your-cerebras-api-key-here

# Together AI (FREE models available, Llama 3.3 70B)
# Sign up at https://api.together.xyz/ — free tier with free models
TOGETHER_API_KEY=your-together-api-key-here

# SambaNova API (FREE! Fast inference, Llama 3.1)
# Sign up at https://cloud.sambanova.ai/ — free tier available
SAMBANOVA_API_KEY=your-sambanova-api-key-here

# Cloudflare Workers AI (FREE! 10K tokens/day, Llama 3.1 8B)
# Sign up at https://dash.cloudflare.com/ — free tier included
# CLOUDFLARE_API_KEY=your-cloudflare-api-key-here
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here

# Anthropic Claude API (BEST quality for comprehensive analysis, paid)
# Sign up at https://console.anthropic.com/ for an API key
ANTHROPIC_API_KEY=your-anthropic-api-key-here
