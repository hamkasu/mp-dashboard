# Session Security (CRITICAL for Production)
# Generate a secure random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use the default value in production!
SESSION_SECRET=your-secure-session-secret-change-in-production

# CSRF Protection (Optional - auto-generated if not set)
# Generate a secure random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CSRF_SECRET=your-secure-csrf-secret-here

# Allowed Origins for CSRF Protection (Production Only)
# Comma-separated list of trusted origins for your application
# Replit automatically sets REPLIT_DOMAINS when deployed
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Admin Credentials
# Set these in production (Railway, etc.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecureP@ssw0rd123

# Database Connection
# Automatically provided by Railway when you add PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/database

# Testing Mode (Local Development Only)
# SECURITY WARNING: Only use this for local testing with simple passwords
# NEVER enable this in production!
# Uncomment the line below to allow any password (including "admin", "123", etc.)
# DISABLE_PASSWORD_VALIDATION=true

# Node Environment
# Automatically set by deployment platforms
# NODE_ENV=production

# AI Services for Hansard Analysis
# Get API keys from respective providers (only ONE is required):
# - Gemini: https://ai.google.dev/
# - OpenRouter: https://openrouter.ai/ (FREE credits! Recommended for DeepSeek)
# - Groq: https://console.groq.com/ (FREE and FAST! Recommended)

# Google Gemini API (fallback for AI features)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API (includes FREE DeepSeek R1 model!)
# Sign up at https://openrouter.ai/ for $1-5 FREE credits
# Gives access to DeepSeek, Qwen, Llama, Gemini, and many other models
# REQUIRED for Grok AI review features (bill PDF analysis and MP comparisons)
# Uses Gemini 2.0 Flash for comprehensive analysis
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Groq API (FREE and very fast! Uses Llama 3.3 70B)
# Sign up at https://console.groq.com/ for a free API key
# Generous free tier with fast inference speeds
GROQ_API_KEY=your-groq-api-key-here

# Anthropic Claude API (BEST for comprehensive Hansard analysis)
# Sign up at https://console.anthropic.com/ for an API key
# Produces the most detailed and thorough parliamentary analysis
ANTHROPIC_API_KEY=your-anthropic-api-key-here
